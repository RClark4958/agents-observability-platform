# Copy to .env and run `just gen-secrets` to fill the CHANGEME values.
# .env is git-ignored. Real cloud API keys live in ~/.config/secrets/ai.env, not here.

# --- Langfuse infrastructure
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME          # 64 hex chars
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://localhost:3000

# --- Langfuse headless init (project + first user + API keys created on first boot)
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Rick
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
LANGFUSE_LOCAL_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_LOCAL_SECRET_KEY=sk-lf-CHANGEME
# base64("pk:sk"); gen-secrets computes it
LANGFUSE_OTEL_AUTH=CHANGEME

# --- Collector overlay: noop.yaml (default) or langsmith.yaml
OTEL_EXTRA_CONFIG=noop.yaml
LANGSMITH_PROJECT=payerbench
# LANGSMITH_API_KEY comes from ~/.config/secrets/ai.env via .envrc

# --- Agent / OTel SDK (read by src/payerbench and scripts)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=payerbench
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# --- Model endpoint (local by default: mlx_lm.server or llama-server)
PAYERBENCH_MODEL=local/gpt-oss-120b
OPENAI_BASE_URL=http://localhost:8080/v1
