# direnv: load machine-wide AI keys, then this stack's .env
source_env_if_exists ~/.config/secrets/ai.env
dotenv_if_exists .env

# Projects opt in to the API key explicitly; it is not exported shell-wide.
if [ -n "${ANTHROPIC_API_KEY_DEV:-}" ]; then
  export ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY_DEV"
fi

# uv-managed virtualenv
if [ -d .venv ]; then
  PATH_add .venv/bin
fi
